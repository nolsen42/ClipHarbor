<Project Sdk="Microsoft.NET.Sdk">
  <!-- ClipHarbor for Android. Shares the download engine, models and look with the desktop app
       (the files linked below) and adds a phone screen, the share menu, and yt-dlp through youtubedl-android. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipHarbor</RootNamespace>
    <AssemblyName>ClipHarbor</AssemblyName>
    <ApplicationId>io.github.clipharbor</ApplicationId>
    <ApplicationTitle>ClipHarbor</ApplicationTitle>
    <Version>1.0.0</Version>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- 64-bit ARM: practically every phone from the last several years. (x64 would only add emulators.) -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- youtubedl-android's Python and ffmpeg are .so files that Android has to unpack so they can run. -->
    <AndroidStoreUncompressedFileExtensions>.so</AndroidStoreUncompressedFileExtensions>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\openjdk')">$(LOCALAPPDATA)\Android\openjdk</JavaSdkDirectory>
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">nolsen42/ClipHarbor</UpdateRepo>
  </PropertyGroup>

  <!-- Shared with the desktop app. -->
  <ItemGroup>
    <Compile Include="..\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\Engine.cs" Link="Shared\Engine.cs" />
    <Compile Include="..\Platform.cs" Link="Shared\Platform.cs" />
    <Compile Include="..\Ui.cs" Link="Shared\Ui.cs" />
    <Compile Include="..\DownloadList.cs" Link="Shared\DownloadList.cs" />
    <AvaloniaXaml Include="..\App.axaml" Link="App.axaml" />
    <AndroidResource Include="..\assets\ClipHarbor.png" Link="Resources\drawable\appicon.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <!-- Android's automatic usings clash with Avalonia's Button, Application, ProgressBar... -->
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS" />
    <Using Remove="Android.Content" />
    <Using Remove="Android.Views" />
    <Using Remove="Android.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="2.4.21" />
    <!-- Newer drawing libraries than Avalonia 11.3 asks for: these are built for phones with 16 KB memory pages. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="8.3.1.5" />
  </ItemGroup>

  <!-- yt-dlp with Python, and ffmpeg, for Android: youtubedl-android (the library Seal uses). -->
  <ItemGroup>
    <AndroidMavenLibrary Include="io.github.junkfood02.youtubedl-android:library" Version="0.18.1" />
    <AndroidMavenLibrary Include="io.github.junkfood02.youtubedl-android:common" Version="0.18.1" />
    <AndroidMavenLibrary Include="io.github.junkfood02.youtubedl-android:ffmpeg" Version="0.18.1" />
    <AndroidMavenLibrary Include="com.fasterxml.jackson.core:jackson-databind" Version="2.11.1" Bind="false" />
    <AndroidMavenLibrary Include="com.fasterxml.jackson.core:jackson-annotations" Version="2.11.1" Bind="false" />
    <AndroidMavenLibrary Include="com.fasterxml.jackson.core:jackson-core" Version="2.11.1" Bind="false" />
    <AndroidMavenLibrary Include="commons-io:commons-io" Version="2.5" Bind="false" />
    <AndroidMavenLibrary Include="org.apache.commons:commons-compress" Version="1.12" Bind="false" />
  </ItemGroup>
</Project>
