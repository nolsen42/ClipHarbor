<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipHarbor</AssemblyName>
    <RootNamespace>ClipHarbor</RootNamespace>
    <ApplicationIcon>assets\ClipHarbor.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <Product>ClipHarbor</Product>
    <Version>1.0.0</Version>
    <Description>Free, open-source video and audio downloader.</Description>
    <Copyright>Copyright (c) 2026 ClipHarbor contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Where the app looks for new releases (owner/name on GitHub). The GitHub build sets it to the repository it runs in. -->
  <PropertyGroup>
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">nolsen42/ClipHarbor</UpdateRepo>
  </PropertyGroup>

  <!-- The Android app has its own project in android/ and shares some of these files. -->
  <ItemGroup>
    <Compile Remove="android/**" />
    <AvaloniaXaml Remove="android/**" />
    <None Remove="android/**" />
    <EmbeddedResource Remove="android/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <AvaloniaResource Include="assets\ClipHarbor.ico" />
    <!-- Translations (Lang.cs). -->
    <EmbeddedResource Include="assets\lang\*.json" LogicalName="ClipHarbor.lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

</Project>
